# -------------------------------
# Agent Configuration (Do not modify)
# -------------------------------
.agents/

# -------------------------------
# Markdown Files
# -------------------------------
# Ignore markdown files in root by default
/*.md

# But keep these essential files in root
!README.md
!CHANGELOG.md
!LICENSE.md
!CONTRIBUTING.md

# Keep all markdown files in these directories
!spec/**/*.md
!docs/**/*.md
!code/**/*.md
